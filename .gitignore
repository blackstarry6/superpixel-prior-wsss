*.pth
!*_proj.pth
cam_*/
fm_weights/
analysis/fm_feat/
model/
log/seamv1*
runs/
tblog/

# ── generated figures (recreate with make_figures.py) ─────
figures/

# ── misc ───────────────────────────────────────────────────
__pycache__/
*.pyc
*.bak
*.zip
.DS_Store
